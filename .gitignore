# Python
__pycache__/
*.pyc
*.pyo

# Base de datos local del historial de auditorías (se regenera sola al usar la app)
data/

# Documentos e imágenes generados en tiempo de ejecución (contienen datos personales
# de las cédulas procesadas -- NUNCA deben subirse al repositorio)
static/uploads/
# Imágenes anotadas del caché de OCR: mismo caso que uploads/ -- son fotos de cédulas
# reales, con nombres y números visibles. Se regeneran solas al volver a auditar.
static/ocr_cache/

# Empaquetado del ejecutable
build/
dist/
*.spec.bak

# Ruta local de poppler para desarrollo (cada quien la tiene en un lugar distinto)
poppler_path.txt

# Entornos virtuales
.venv/
venv/
env/

# Logs del servidor en desarrollo
*.log
*.log.err

# Editor / herramientas locales
.vscode/
.claude/
